{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lo justo: la ventana (encoger a mini, crecer con el buscador del mini, siempre encima), abrir enlaces, reiniciar, elegir carpetas de musica y archivos para importar/exportar, buscar e instalar actualizaciones firmadas",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-set-position",
    "core:window:allow-unmaximize",
    "opener:allow-open-url",
    "process:allow-restart",
    "updater:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
